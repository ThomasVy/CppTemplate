#!/usr/bin/env bash
set -euo pipefail

staged_files=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(h|hpp|c|cpp)$' || true)

if [ -z "$staged_files" ]; then
    exit 0
fi

if command -v clang-format >/dev/null 2>&1; then
    echo "Running clang-format on staged files..."
    echo "$staged_files" | xargs -r clang-format -i
    echo "$staged_files" | xargs -r git add
else
    echo "Warning: clang-format not found in PATH"
fi

if command -v clang-tidy >/dev/null 2>&1; then
    echo "Running clang-tidy on staged source files..."
    build_dir="${CPP_TEMPLATE_BUILD_DIR:-build/debug}"
    tu_files=$(echo "$staged_files" | grep -E '\.(c|cpp)$' || true)
    if [ -n "$tu_files" ] && [ -f "${build_dir}/compile_commands.json" ]; then
        echo "$tu_files" | xargs -r clang-tidy -p "${build_dir}"
    else
        echo "Warning: no staged .c/.cpp files or ${build_dir}/compile_commands.json not found; skipping clang-tidy"
    fi
else
    echo "Warning: clang-tidy not found in PATH"
fi

exit 0
